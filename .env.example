# Copy this file to .env and fill in your own values.
# .env is gitignored; this file is committed as the template.

# --- Required ---

# PostgreSQL connection. PGUSER must be permitted to run CREATE DATABASE.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres

# Database this framework creates and uses.
ETL_DB=etl_migration

# --- Optional (defaults shown are what config.py falls back to if omitted) ---

# Leave blank if your local Postgres user has no password set.
PGPASSWORD=

# An existing database used only to issue the CREATE DATABASE statement.
PGADMIN_DB=postgres

# Schema names. These are what every example in README.md, MAPPING_BOOK.md
# and QUERYBOOK.sql assumes — change only if you have a reason to.
STAGE_SCHEMA=stage
PROD_SCHEMA=prod
META_SCHEMA=etl_meta
REF_SCHEMA=ref

# Where ingest.py looks for source files, relative to the project root.
SOURCE_DIR=source_files
